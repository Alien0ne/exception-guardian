{
  "permissions": {
    "deny": [
      "Bash(exception-guardian approve * --apply*)",
      "Bash(.venv/bin/exception-guardian approve * --apply*)",
      "Bash(python -m exception_guardian approve * --apply*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git push*)",
      "Bash(gh *)",
      "Read(**/.env)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env |*)",
      "Bash(env -0*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_apply.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\""
          }
        ]
      }
    ]
  }
}
